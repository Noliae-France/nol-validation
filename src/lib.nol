// nol.validation — validation déclarative avec erreurs structurées, en pur Nolc.
//
// Fondation du module : chaque validateur renvoie une liste d'erreurs (vide =
// valide), agrégeable. Les règles avancées (email, JSON imbriqué, fichiers
// téléversés, schémas) arrivent dans les versions suivantes — voir README.

record ErreurValidation {
    champ: Text,
    message: Text
}

// Agrège deux listes d'erreurs.
fn valid_fusion(a: List<ErreurValidation>, b: List<ErreurValidation>) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    for e in a {
        push(out, e)
    }
    for e in b {
        push(out, e)
    }
    return out
}

// Champ obligatoire : erreur si la valeur est vide.
fn valide_requis(champ: Text, valeur: Text) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    if len(valeur) == 0 {
        push(out, ErreurValidation { champ: champ, message: "obligatoire" })
    }
    return out
}

// Longueur bornée [min, max]. `max <= 0` => pas de borne haute.
fn valide_longueur(champ: Text, valeur: Text, min: Int, max: Int) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    let n = len(valeur)
    if n < min {
        push(out, ErreurValidation { champ: champ, message: "trop court (min " + text(min) + ")" })
    }
    if max > 0 and n > max {
        push(out, ErreurValidation { champ: champ, message: "trop long (max " + text(max) + ")" })
    }
    return out
}

// Entier borné [min, max].
fn valide_plage(champ: Text, valeur: Int, min: Int, max: Int) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    if valeur < min or valeur > max {
        push(out, ErreurValidation { champ: champ, message: "hors plage [" + text(min) + ", " + text(max) + "]" })
    }
    return out
}

// Adresse e-mail plausible : une partie locale non vide, un « @ », puis un
// domaine contenant un « . » qui n'est ni en tête ni en fin. Validation
// pragmatique (pas la RFC complète), suffisante pour un formulaire.
fn valide_email(champ: Text, valeur: Text) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    let at = unwrap_or(find(valeur, "@"), -1)
    var ok = true
    if at <= 0 {
        ok = false
    }
    if ok {
        let domaine = sub(valeur, at + 1, len(valeur) - at - 1)
        let point = unwrap_or(find(domaine, "."), -1)
        // « . » présent, pas en première position, pas en dernière.
        if point <= 0 or point >= len(domaine) - 1 {
            ok = false
        }
    }
    if not ok {
        push(out, ErreurValidation { champ: champ, message: "adresse e-mail invalide" })
    }
    return out
}

// La chaîne n'est composée que de chiffres (entier non signé non vide).
fn valide_numerique(champ: Text, valeur: Text) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    var ok = len(valeur) > 0
    var i = 0
    while i < len(valeur) {
        let c = char_at(valeur, i)
        if unwrap_or(find("0123456789", c), -1) < 0 {
            ok = false
        }
        i += 1
    }
    if not ok {
        push(out, ErreurValidation { champ: champ, message: "doit être numérique" })
    }
    return out
}

// La valeur appartient à l'ensemble autorisé (énumération).
fn valide_dans(champ: Text, valeur: Text, autorisees: List<Text>) -> List<ErreurValidation> {
    var out: List<ErreurValidation> = []
    var trouve = false
    for a in autorisees {
        if a == valeur {
            trouve = true
        }
    }
    if not trouve {
        push(out, ErreurValidation { champ: champ, message: "valeur non autorisée" })
    }
    return out
}

// La validation a-t-elle réussi ?
fn valid_ok(erreurs: List<ErreurValidation>) -> Bool {
    return len(erreurs) == 0
}

// ============================ TESTS ============================

fn test_requis() {
    assert(valid_ok(valide_requis("nom", "Alice")), "non vide = ok")
    assert(not valid_ok(valide_requis("nom", "")), "vide = erreur")
}

fn test_longueur() {
    assert(valid_ok(valide_longueur("code", "abcd", 2, 8)), "dans les bornes")
    assert(not valid_ok(valide_longueur("code", "a", 2, 8)), "trop court")
    assert(not valid_ok(valide_longueur("code", "abcdefghi", 2, 8)), "trop long")
}

fn test_plage() {
    assert(valid_ok(valide_plage("age", 30, 0, 120)), "age valide")
    assert(not valid_ok(valide_plage("age", 200, 0, 120)), "age hors plage")
}

fn test_fusion() {
    let e = valid_fusion(valide_requis("a", ""), valide_plage("b", 5, 0, 3))
    assert(len(e) == 2, "deux erreurs agregees")
    assert(not valid_ok(e), "non valide")
}

fn test_email() {
    assert(valid_ok(valide_email("courriel", "alice@example.com")), "email valide")
    assert(not valid_ok(valide_email("courriel", "alice")), "sans @")
    assert(not valid_ok(valide_email("courriel", "@example.com")), "partie locale vide")
    assert(not valid_ok(valide_email("courriel", "alice@localhost")), "domaine sans point")
    assert(not valid_ok(valide_email("courriel", "alice@ex.")), "point final")
}

fn test_numerique() {
    assert(valid_ok(valide_numerique("n", "12345")), "chiffres")
    assert(not valid_ok(valide_numerique("n", "12a45")), "lettre presente")
    assert(not valid_ok(valide_numerique("n", "")), "vide")
}

fn test_dans() {
    var options: List<Text> = []
    push(options, "rouge")
    push(options, "vert")
    assert(valid_ok(valide_dans("couleur", "vert", options)), "dans l'ensemble")
    assert(not valid_ok(valide_dans("couleur", "bleu", options)), "hors ensemble")
}
